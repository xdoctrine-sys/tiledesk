# Tiledesk trial on Railway - variable names (NO secret values in this file).
#
# Copy one block per Railway service. Values marked <generated> come from
# ./gen-rabbitmq-tokens.sh and must be stored in a local, mode-600 file - never
# committed and never pasted into tickets or reports.
#
# Internal hostnames follow Railway private networking:
#   <service-name>.railway.internal  (dual stack: A + AAAA, project scoped)

# ---------------------------------------------------------------- shared ----
# Set on: tiledesk-trial-server, tiledesk-trial-dashboard, tiledesk-trial-widget,
#         tiledesk-trial-chatbot
EXTERNAL_BASE_URL=https://<proxy-public-host>
EXTERNAL_MQTT_BASE_URL=wss://<proxy-public-host>

# ------------------------------------------------- tiledesk-trial-mongo ----
# image: mongo:7.0.2
# volume: /data/db
# start command: docker-entrypoint.sh mongod --ipv6 --bind_ip ::,0.0.0.0
(no variables)

# ------------------------------------------------- tiledesk-trial-redis ----
# image: redis:7.0.5
# start command: redis-server --protected-mode no --bind ::
(no variables)

# ---------------------------------------------- tiledesk-trial-rabbitmq ----
# image: chat21/chat21-rabbitmq@sha256:49fd...
RABBITMQ_ERLANG_COOKIE=<generated random string>
RABBITMQ_DEFAULT_USER=<generated random user>
RABBITMQ_DEFAULT_PASS=<generated random password>

# ----------------------------------------- tiledesk-trial-chat21server ----
# image: chat21/chat21-server:0.2.53
LOG_LEVEL=info
MONGODB_URI=mongodb://tiledesk-trial-mongo.railway.internal:27017/chat21
APP_ID=tilechat
WEBHOOK_ENABLED=true
WEBHOOK_EVENTS=message-sent,message-delivered,conversation-unarchived
WEBHOOK_ENDPOINTS=<generated: http://tiledesk-trial-server.railway.internal:3000/chat21/requests,http://tiledesk-trial-chat21http.railway.internal:8004/api/tilechat/push/webhook/endpoint/<PUSH_WH_WEBHOOK_TOKEN>>
# chat21-server 0.2.53 reads RABBITMQ_URI (NOT CHAT21_SRV_RABBITMQ_URI); with
# the wrong name it exits at boot with
# "Error: please configure process.env.RABBITMQ_URI".
RABBITMQ_URI=<generated>

# -------------------------------------------- tiledesk-trial-chat21http ----
# image: chat21/chat21-http-server:0.2.37
LOG_LEVEL=info
MONGODB_URI=mongodb://tiledesk-trial-mongo.railway.internal:27017/chat21
JWT_KEY=tokenKey
RABBITMQ_URI=<generated>
PUSH_ENABLED=true
CHAT21HTTP_CACHE_ENABLED=false
CONTACTS_LOOKUP_ENDPOINT=http://tiledesk-trial-server.railway.internal:3000/users_util
PUSH_WH_NOTIFY_URL=http://tiledesk-trial-chat21http.railway.internal:8004/api/tilechat/notify
PUSH_WH_WEBHOOK_TOKEN=<generated>
PUSH_WH_CHAT21_API_ADMIN_TOKEN=<generated>
# Firebase push is not configured for the trial (PUSH_ENABLED stays true but no
# Firebase credentials are supplied, so push notifications are inert).

# ------------------------------------------------ tiledesk-trial-server ----
# image: tiledesk/tiledesk-server:2.13.23-op1
LOG_LEVEL=info
COMMUNITY_VERSION=true
JWT_SECRET_KEY=tokenKey
CHAT21_ENABLED=true
CHAT21_ENGINE=mqtt
CHAT21_APPID=tilechat
CHAT21_JWT_SECRET=tokenKey
CHAT21_URL=http://tiledesk-trial-chat21http.railway.internal:8004
CHAT21_ADMIN_TOKEN=<generated>
AMQP_MANAGER_URL=<generated>
MONGODB_URI=mongodb://tiledesk-trial-mongo.railway.internal:27017/tiledesk
CACHE_ENABLED=true
CACHE_ENGINE=redis
CACHE_REDIS_HOST=tiledesk-trial-redis.railway.internal
CACHE_REDIS_PORT=6379
APPS_ACCESS_TOKEN_SECRET=<generated random string>
BOOT_LOADING=true
RESTHOOK_ENABLED=true
ALLOW_REOPEN_CHAT=true
QUOTES_ENABLED=false
META_GRAPH_URL=https://graph.facebook.com/v20.0/
TELEGRAM_API_URL=https://api.telegram.org/bot
TELEGRAM_FILE_URL=https://api.telegram.org/file/bot
TELEGRAM_LOG=info
WEBHOOK_ORIGIN=<EXTERNAL_BASE_URL>/api/
WIDGET_LOCATION=<EXTERNAL_BASE_URL>/widget/
EMAIL_BASEURL=<EXTERNAL_BASE_URL>/dashboard
BASE_FILE_URL=<EXTERNAL_BASE_URL>/api/
TILEBOT_ENDPOINT=http://tiledesk-trial-chatbot.railway.internal:3000
GPTKEY=CHANGEIT
VECTOR_STORE_NAME=qdrant
INDEX_TYPE=serverless
INDEX_NAME=tiledesk-llm
VECTOR_SIZE=1536
VECTOR_STORE_HOST=tiledesk-trial-qdrant
VECTOR_STORE_PORT=6333
VECTOR_STORE_DEPLOYMENT=local
JOB_TOPIC_EXCHANGE_TRAIN=tiledesk-trainer
# NOT set for the trial: EMAIL_* (SMTP deliberately absent), LICENSE_KEY (no
# Enterprise licence), FB_APP_*, GPTKEY (no paid AI key), KB_ENDPOINT_* (the
# optional backend-llm services are not deployed).

# ----------------------------------------------- tiledesk-trial-chatbot ----
# image: tiledesk/tiledesk-chatbot:2.0.32-rc8
API_ENDPOINT=http://tiledesk-trial-server.railway.internal:3000
TILEBOT_ENDPOINT=http://tiledesk-trial-chatbot.railway.internal:3000
API_URL=<EXTERNAL_BASE_URL>/api
MONGODB_URI=mongodb://tiledesk-trial-mongo.railway.internal:27017/tiledesk
CACHE_ENABLED=true
CACHE_REDIS_HOST=tiledesk-trial-redis.railway.internal
CACHE_REDIS_PORT=6379
TILEBOT_LOG=info
FLOW_LOGS_ENABLED=true
AMQP_MANAGER_URL=<generated>
GPTKEY=CHANGEIT
# AI_ENDPOINT / KB_ENDPOINT_* intentionally omitted (no LLM services deployed).

# --------------------------------------------- tiledesk-trial-dashboard ----
# image: tiledesk/tiledesk-dashboard:2.7.134-stage
FEATURES_TOKEN=PAY:F-ANA:T-ACT:T-TRI:T-GRO:T-DEP:T-OPH:T-MTL:T-CAR:T-PSA:F-MTT:T-SUP:T-LBS:T-APP:T-DEV:F-NOT:T-IPS:F-ETK:F-RAS:F-PPB:F-PET:F-MTS:F-TIL:T-DGF:T-NAT:T-HPB:F-TOW:F-KNB:T-GPT:T-BAN:F-AST:F-MON:T-CNT:F-AUT:F-WUN:F-INT:T-DPA:T
BOT_CREDENTIAL_URL=/api/modules/dialogflow/botcredendials/
WIDGET_LOCATION=<EXTERNAL_BASE_URL>/widget/
SERVER_BASE_URL=/api/
CHAT_BASE_URL=/chat/
CDS_BASE_URL=/cds/
WS_URL_RELATIVE=/ws/
CHAT21_ENGINE=mqtt
UPLOAD_ENGINE=native
PUSH_ENGINE=none
LOG_LEVEL=info
APPS_URL=/api/modules/apps/
API_BASEIMAGE_URL=/api/
COMMUNITY_TEMPLATES_URL=/api/modules/templates/public/community
TEMPLATES_URL=/api/modules/templates/public/templates
FILE_UPLOAD_ACCEPT=*/*

# ------------------------------------------------ tiledesk-trial-widget ----
# image: chat21/chat21-web-widget:5.1.2
CHAT21_ENGINE=mqtt
MQTT_APPID=tilechat
PUSH_ENGINE=none
LOG_LEVEL=info
MQTT_ENDPOINT=<EXTERNAL_MQTT_BASE_URL>/mqws/ws
MQTT_APIENDPOINT=<EXTERNAL_BASE_URL>/chatapi/api
FIREBASE_TENANT=tilechat
UPLOAD_ENGINE=native
SERVER_BASE_URL=<EXTERNAL_BASE_URL>/api/
TRANSLATIONS_URL=<EXTERNAL_BASE_URL>/api/
API_BASEIMAGE_URL=<EXTERNAL_BASE_URL>/api/
DASHBOARD_URL=/dashboard/
AUTH_PERSISTENCE=LOCAL
ENBED_JS=true
FILE_UPLOAD_ACCEPT=*/*

# ------------------------------------------------- tiledesk-trial-proxy ----
# image: built from this fork (deploy/railway/proxy/Dockerfile)
# public domain, target port 80, healthcheck /healthz
(none, routing is compiled into the image)
